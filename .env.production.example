# 線上版環境變數範例

# 資料庫設定（使用 Neon PostgreSQL）
DATABASE_URL=postgresql+asyncpg://your-user:your-password@your-neon-host.neon.tech:5432/neondb?sslmode=require

# Redis 設定（使用 Upstash Redis）
REDIS_URL=rediss://default:your-token@your-upstash-host.upstash.io:6379

# CORS 設定（生產環境）
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://www.your-frontend-domain.com

# 調試模式（生產環境設為 false）
DEBUG=false

# 身份驗證設定（可選功能）
REQUIRE_AUTH=false
ALLOWED_EMAILS=your-email@example.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API 設定
API_TITLE=TW Stock Chip Dashboard API
API_VERSION=1.0.0

# 環境類型
ENVIRONMENT=production

# 資料保留天數（250 個交易日約 10 個月）
DATA_RETENTION_DAYS=250

# 清理時是否執行 VACUUM（釋放磁碟空間）
CLEANUP_VACUUM=true

# 效能設定
MAX_WORKERS=20
MAX_API_WORKERS=10
MAX_CONCENTRATION_WORKERS=10
ENABLE_CONCENTRATION=true
LOG_LEVEL=INFO
